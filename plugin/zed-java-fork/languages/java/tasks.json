[
  {
    "label": "Run $ZED_CUSTOM_java_class_name",
    "command": "\"$ZED_CUSTOM_java_task_runner\" --java-task main",
    "use_new_terminal": false,
    "reveal": "always",
    "tags": [
      "java-main"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "show_command": false
  },
  {
    "label": "$ZED_CUSTOM_java_class_name.${ZED_CUSTOM_java_outer_class_name:}.$ZED_CUSTOM_java_method_name",
    "command": "\"$ZED_CUSTOM_java_task_runner\" --java-task method",
    "use_new_terminal": false,
    "reveal": "always",
    "tags": [
      "java-test-method",
      "java-test-method-nested"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "show_command": false
  },
  {
    "label": "Test class $ZED_CUSTOM_java_class_name",
    "command": "\"$ZED_CUSTOM_java_task_runner\" --java-task class",
    "use_new_terminal": false,
    "reveal": "always",
    "tags": [
      "java-test-class",
      "java-test-class-nested"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "show_command": false
  },
  {
    "label": "Run tests",
    "command": "\"$ZED_CUSTOM_java_task_runner\" --java-task all",
    "use_new_terminal": false,
    "reveal": "always",
    "tags": [
      "java-test-all"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "show_command": false
  },
  {
    "label": "Clear default JDTLS cache",
    "command": "\"$ZED_CUSTOM_java_task_runner\" --java-task cache",
    "use_new_terminal": false,
    "reveal": "always",
    "tags": [
      "java-clear-cache"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "show_command": false
  }
]
